+struct ReviewBarrierRegistry {
+    inner: Arc<dyn pij_core::ports::Registry>,
+    gate: tokio::sync::Barrier,
+}
+
+#[async_trait::async_trait]
+impl pij_core::ports::Registry for ReviewBarrierRegistry {
+    async fn get(&self, seat: &SeatId) -> pij_core::error::Result<Option<SeatDescriptor>> {
+        self.gate.wait().await;
+        self.inner.get(seat).await
+    }
+    async fn put(&self, descriptor: SeatDescriptor) -> pij_core::error::Result<pij_core::model::Seq> {
+        self.inner.put(descriptor).await
+    }
+    async fn put_reporting(&self, d: SeatDescriptor) -> pij_core::error::Result<(pij_core::model::Seq, pij_core::ports::PutBinding)> {
+        self.inner.put_reporting(d).await
+    }
+    async fn put_reporting_keeping_parent(&self, d: SeatDescriptor) -> pij_core::error::Result<(pij_core::model::Seq, pij_core::ports::PutBinding)> {
+        self.inner.put_reporting_keeping_parent(d).await
+    }
+    async fn list(&self, f: pij_core::ports::SeatFilter) -> pij_core::error::Result<Vec<SeatDescriptor>> {
+        self.inner.list(f).await
+    }
+    async fn tombstone(&self, seat: &SeatId, reason: &str) -> pij_core::error::Result<pij_core::model::Seq> {
+        self.inner.tombstone(seat, reason).await
+    }
+    async fn tombstone_if_unchanged(&self, expected: SeatDescriptor, reason: String) -> pij_core::error::Result<pij_core::model::Seq> {
+        self.inner.tombstone_if_unchanged(expected, reason).await
+    }
+    async fn set_activity(&self, seat: &SeatId, state: pij_core::model::SystemState, reason: Option<&str>) -> pij_core::error::Result<Option<pij_core::model::Seq>> {
+        self.inner.set_activity(seat, state, reason).await
+    }
+}
