+#[tokio::test]
+async fn review_overlapping_assign_drains_must_deliver_an_unscoped_request_once() {
+    let repo = repo("pij-review-role-double-drain");
+    let rig = rig(Arc::new(NoHook)).await;
+    with_roles(rig.addr, &repo).await;
+    let queued = send_to(rig.addr, &repo.main, "role:reviewer", "double-drain", json!({})).await;
+    assert_eq!(queued["data"]["request"]["state"], "queued", "{queued}");
+    for (target, seat) in [("reviewer/a", "pij-holder"), ("reviewer/b", "pij-second")] {
+        let assigned = call(rig.addr, "/v1/directory",
+            &["directory", "assign", target, seat, "--why", "review"],
+            &repo.main).await;
+        assert_eq!(assigned["ok"], true, "{assigned}");
+    }
+    let gated_registry = Arc::new(ReviewBarrierRegistry {
+        inner: rig.services.registry.clone(),
+        gate: tokio::sync::Barrier::new(2),
+    });
+    let delivery = Arc::new(pij_daemon::delivery::DeliveryService::new(
+        gated_registry, rig.services.queue.clone(), rig.services.transport.clone(),
+        rig.services.interaction.clone(), rig.services.event_bus.clone()).unwrap());
+    let first_seat = SeatId::from("pij-holder");
+    let second_seat = SeatId::from("pij-second");
+    let drained = tokio::time::timeout(std::time::Duration::from_secs(30), async {
+        tokio::join!(
+            pij_daemon::delivery::role_send::drain(&rig.store, &delivery, "fleet", "reviewer", "a", &first_seat),
+            pij_daemon::delivery::role_send::drain(&rig.store, &delivery, "fleet", "reviewer", "b", &second_seat)
+        )
+    }).await.expect("both drains complete");
+    let first_inbox = inbox_bodies(&rig, "pij-holder").await;
+    let second_inbox = inbox_bodies(&rig, "pij-second").await;
+    let stored = rig.store.role_request("double-drain").await.unwrap().unwrap();
+    eprintln!("DOUBLE-DRAIN: outcomes={drained:?}; stored_holder={:?}; inboxes={first_inbox:?}/{second_inbox:?}", stored.holder);
+    rig.server.abort();
+    assert_eq!(first_inbox.len() + second_inbox.len(), 1, "one request reached two assigned holders");
+}
