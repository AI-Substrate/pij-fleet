+/// Red proof at fd7bf41 for #129 security S1: a drain for a released holder
+/// must not consume a request queued after its release.
+#[tokio::test]
+async fn security_s1_released_holder_never_drains() {
+    let repo = repo("pij-security-s1");
+    let rig = rig(Arc::new(NoHook)).await;
+    with_roles(rig.addr, &repo).await;
+    for argv in [
+        ["directory", "assign", "pm-001", "pij-holder", "--why", "lead"],
+        ["directory", "release", "pm-001", "pij-holder", "--why", "done"],
+    ] {
+        let done = call(rig.addr, "/v1/directory", &argv, &repo.main).await;
+        assert_eq!(done["ok"], true, "{done}");
+    }
+    let queued = send_to(rig.addr, &repo.main, "role:pm-001", "after-release", json!({})).await;
+    assert_eq!(queued["data"]["request"]["state"], "queued", "{queued}");
+    let old = SeatId::from("pij-holder");
+    let stale = pij_daemon::delivery::role_send::drain(&rig.store, &rig.delivery, "fleet", "pm-001", "", &old).await;
+    rig.server.abort();
+    assert!(stale.is_empty(), "the released holder claimed: {stale:?}");
+}
