            },
            "why": {
              "type": "text"
            }
          }
        }
      }
    },
    "side_effects": {
      "shape": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path",
            "why"
          ],
          "fields": {
            "path": {
              "type": "string"
            },
            "why": {
              "type": "text"
            }
          }
        }
      }
    },
    "comments": {
      "shape": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "date",
            "by",
            "text"
          ],
          "fields": {
            "date": {
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "text": {
              "type": "text"
            }
          }
        }
      }
    },
    "changelog": {
      "shape": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "date",
            "by",
            "change"
          ],
          "fields": {
            "date": {
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "change": {
              "type": "text"
            }
          }
        }
      }
    }
  }
}
