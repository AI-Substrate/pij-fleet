# pij telegram bridge — config template (keys only, NO real secrets).
#
# `pij telegram init` writes these three keys for you — to ~/.pij/telegram.env (or to
# $PIJ_TELEGRAM_ENV when set) — and captures your Telegram id automatically. Copy this
# file and fill it in by hand only if you prefer manual setup. NEVER commit a real token:
# `.env` and `.env.*` are gitignored; this `.env.example` is the one tracked exception.

# BotFather HTTP API token (the bot's secret). Required — the bridge fails closed without it.
TELEGRAM_BOT_TOKEN=123456789:AA-replace-with-your-botfather-token

# Comma-separated Telegram numeric user ids allowed to drive the bridge. This IS the only
# access control — anyone not on this list is silently ignored. `init` fills it with the id
# of whoever sends the bot its first message.
TELEGRAM_ALLOWED_USER_IDS=111111111

# Operator chat id for OUTBOUND relay (session replies → Telegram); usually the same as your
# user id for a 1:1 DM. Optional — omit it to run inbound-only (you send, nothing streams back).
TELEGRAM_CHAT_ID=111111111
