    {
      "name": "architecture",
      "value": {
        "principles": "A card read touches only the seat's own rows through an index; its cost never grows with the spine. Card content stays exactly as it is (a golden comparison proves it); new fields are additive. One bulk call replaces 84 calls."
      }
    },
