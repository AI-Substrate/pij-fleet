    {
      "name": "meta",
      "value": {
        "title": "Seat-name sweep: conservative removal in both runtimes",
        "plan": "../plan.dd.json#meta",
        "version": 1
      }
    },
    {
      "name": "architecture",
      "value": {
        "principles": "The corpus is data vendored twice; change both in one commit and let the existing oracle test prove they agree. Removal is the only operation: no additions, no reordering beyond deleting entries, no algorithm change. The judgement is deliberately conservative: a word that a reasonable reader could take as sensitive, judgemental or someone else's IP goes, even if its main sense is innocent. Existing ids are stored, not recomputed (verify; stop if not).",
        "composition_root": "crates/core/src/name_corpus.rs and .omp/extensions/pij/core/name-corpus.ts",
        "contracts": [
          "EXCLUDED_NAME_WORDS (both runtimes): every removed word, and the test that no list (including each ship-name word) contains one",
          "assets/audit.md: removed word, list, category; reviewed counts per list"
        ],
        "seams": [
          "crates/core/src/name_corpus.rs",
          ".omp/extensions/pij/core/name-corpus.ts",
          "crates/core/tests/memorable_ids.rs",
          ".omp/extensions/pij/core/memorable-id.test.ts"
        ]
      }
    },
    {
      "name": "fan_out",
      "value": {
        "decision": "solo-pm",
        "rationale": "One data change mirrored in two files; splitting would risk the runtimes diverging."
      }
