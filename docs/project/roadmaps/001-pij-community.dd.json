        {
          "id": "s04",
          "title": "Assign, release, lineage and the directory view",
          "state": "planned",
          "delivers": [
            "../001-pij-community/prd.dd.json#requirements/req-01",
            "../001-pij-community/prd.dd.json#requirements/req-06",
            "../001-pij-community/prd.dd.json#requirements/req-16",
