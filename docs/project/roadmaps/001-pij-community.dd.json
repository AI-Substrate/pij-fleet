          "title": "Docs system and the community PRD",
          "state": "in-progress",
          "delivers": [
            "../001-pij-community/prd.dd.json#requirements/req-18"
          ],
          "builds": [
            "../001-pij-community/blueprint.dd.json#components/c-doc-schemas"
          ],
          "depends_on": [],
          "done_when": "Schemas resolve; this PRD, its blueprint and this roadmap validate clean; `ddocs graph` draws the joins."
        },
        {
          "id": "s02",
          "title": "Role schema, layout and the governance writer",
          "state": "planned",
          "delivers": [
            "../001-pij-community/prd.dd.json#requirements/req-02",
            "../001-pij-community/prd.dd.json#requirements/req-03",
            "../001-pij-community/prd.dd.json#requirements/req-04",
            "../001-pij-community/prd.dd.json#requirements/req-05",
            "../001-pij-community/prd.dd.json#requirements/req-17",
            "../001-pij-community/prd.dd.json#requirements/req-19"
