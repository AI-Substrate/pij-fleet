          "delivers": [
            "../001-pij-community/prd.dd.json#requirements/req-12",
            "../001-pij-community/prd.dd.json#requirements/req-14"
          ],
          "builds": [
            "../001-pij-community/blueprint.dd.json#components/c-orient"
          ],
          "depends_on": [
            "#steps/s05",
            "#steps/s06",
            "#steps/s07"
