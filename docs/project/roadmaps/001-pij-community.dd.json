          "state": "planned",
          "delivers": [
            "../001-pij-community/prd.dd.json#requirements/req-13",
            "../001-pij-community/prd.dd.json#requirements/req-15"
          ],
          "builds": [
            "../001-pij-community/blueprint.dd.json#components/c-skill",
