            "../001-pij-community/blueprint.dd.json#components/c-writer"
          ],
          "depends_on": [
            "#steps/s01"
          ],
          "done_when": "`pij directory add` writes a validated role on the governance branch, refuses by name without governance or ddocs, and the cost row is measured."
        },
        {
          "id": "s03",
          "title": "Core and security templates",
          "state": "planned",
          "delivers": [
            "../001-pij-community/prd.dd.json#requirements/req-13",
            "../001-pij-community/prd.dd.json#requirements/req-14"
          ],
          "builds": [
            "../001-pij-community/blueprint.dd.json#components/c-templates"
          ],
          "depends_on": [
