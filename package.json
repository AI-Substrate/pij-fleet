{
	"name": "pij",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"pij": "harness/scripts/pij-cli.cjs",
		"flow-pair": "skills/flow-pair/lib/cli.ts"
	},
	"description": "pij — a cross-harness control plane that lets coding agents (OMP, Claude Code, Copilot CLI, Codex) message, spawn and govern each other.",
