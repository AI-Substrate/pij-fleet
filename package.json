		"@github/copilot-sdk": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@github/copilot-sdk": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@earendil-works/pi-ai": "^0.87.1",
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@earendil-works/pi-tui": "^0.87.1",
		"@types/node": "^22.0.0",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"overrides": {
		"protobufjs": "^7.6.5",
		"postcss": "^8.5.23",
		"nanoid": "^3.3.18",
		"brace-expansion": "^5.0.12"
	}
